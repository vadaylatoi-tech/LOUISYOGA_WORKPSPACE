{% comment %}
  15/10/2026 — Footer theo bản thiết kế mới: logo, Cửa hàng / Chính sách / Về chúng tôi / Thông tin liên hệ, FOLLOW, bản quyền + thanh toán.
  Thông tin liên hệ lấy từ Tuỳ chỉnh giao diện (store_address, store_phone, store_phone1, store_email) — không chép số trong bản vẽ.
  Giữ form "Nhận ưu đãi" (form contact Sapo, cùng cách gửi như footer cũ) để link "Nhận ưu đãi" ở thanh trên vẫn có đích.
  Bản trước: snippets/ly-home-footer.bwt.
{% endcomment %}
{%- assign lyx_fb = settings.social_fb -%}{%- if lyx_fb contains 'thamtapyogalouis' or lyx_fb contains 'sapoweb' -%}{%- assign lyx_fb = 'https://www.facebook.com/thamlouisyoga' -%}{%- endif -%}
{%- assign lyx_ph1 = settings.store_phone | split: '-' -%}{%- assign lyx_ph2 = settings.store_phone1 | split: '-' -%}
<footer class="lyx-foot">
  <div class="lyx-wrap">
    <div class="lyx-foot-top">
      <div class="lyx-foot-brand"><a href="/" class="lyx-logo" aria-label="Louis Yoga — Trang chủ">{% include 'lyx-logo' %}</a></div>
      <div class="lyx-foot-col lyx-foot-col-shop"><h3>Cửa hàng</h3>
        <a href="/tham-yoga-cao-su">Thảm Yoga cao su</a><a href="/tham-yoga-du-lich">Thảm Du lịch</a><a href="/tham-tpe">Thảm TPE</a><a href="/phu-kien-yoga">Phụ kiện Yoga</a>
      </div>
      <div class="lyx-foot-col"><h3>Chính sách</h3>
        <a href="/dieu-khoan-quy-dinh">Điều khoản - Quy định</a><a href="/chinh-sach-kiem-hang">Chính Sách Kiểm Hàng</a><a href="/chinh-sach-bao-mat">Chính Sách Bảo Mật</a><a href="/chinh-sach-ctv">Chính Sách CTV</a><a href="/chinh-sach-dai-ly">Chính Sách Đại Lý</a><a href="/chinh-sach-bao-hanh-doi-tra-san-pham">Chính Sách Bảo Hành - Đổi Trả Sản Phẩm</a>
      </div>
      <div class="lyx-foot-col"><h3>Về chúng tôi</h3>
        <a href="/account/login">Đăng nhập</a><a href="/account/register">Đăng ký</a><a href="/gioi-thieu">Thông tin về công ty</a>
      </div>
      <div class="lyx-foot-col lyx-foot-col-contact"><h3>Thông tin liên hệ</h3>
        {%- if settings.store_address != blank -%}<p>Địa chỉ: {{ settings.store_address }}</p>{%- endif -%}
        <p>Liên hệ mua hàng: {% for ph in lyx_ph1 %}{% assign n = ph | strip %}{% if n != blank %}<a href="tel:{{ n | remove: '.' | remove: ' ' }}" style="display:inline">{{ n }}</a>{% unless forloop.last %} - {% endunless %}{% endif %}{% endfor %}</p>
        {%- if settings.store_phone1 != blank -%}<p>Bảo hành - khiếu nại: {% for ph in lyx_ph2 %}{% assign n = ph | strip %}{% if n != blank %}<a href="tel:{{ n | remove: '.' | remove: ' ' }}" style="display:inline">{{ n }}</a>{% unless forloop.last %} - {% endunless %}{% endif %}{% endfor %}</p>{%- endif -%}
        {%- if settings.store_email != blank -%}<p>Email: <a href="mailto:{{ settings.store_email }}" style="display:inline">{{ settings.store_email }}</a></p>{%- endif -%}
        {% form 'contact' %}
          <div class="lyx-news" id="lyx-news">
            <input type="hidden" name="contact[Name]" value="Khách đăng ký nhận tin"><input type="hidden" name="contact[body]" value="Đăng ký nhận tin từ Louis Yoga">
            <label class="lyx-sr" for="lyx-email">Email nhận ưu đãi</label><input id="lyx-email" name="contact[email]" type="email" required placeholder="Email nhận ưu đãi" autocomplete="email"><button type="submit">Đăng ký</button>
          </div>
          {%- if form.posted_successfully -%}<p role="status">Đã gửi đăng ký nhận ưu đãi.</p>{%- endif -%}{%- if form.errors -%}<p role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        {% endform %}
      </div>
    </div>
    <hr class="lyx-foot-rule">
    <div class="lyx-foot-follow">
      <b>FOLLOW</b>
      {%- if settings.social_insta != blank and settings.social_insta contains 'instagram' -%}<a href="{{ settings.social_insta }}" target="_blank" rel="noopener" aria-label="Instagram Louis Yoga"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".6"/></svg></a>{%- endif -%}
      {%- if lyx_fb != blank -%}<a href="{{ lyx_fb }}" target="_blank" rel="noopener" aria-label="Facebook Louis Yoga"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8.5V6.8c0-.8.2-1.3 1.4-1.3H17V2.3c-.3 0-1.2-.1-2.4-.1-2.4 0-4 1.4-4 4.1v2.2H8v3.3h2.6V21H14v-9.2h2.7l.4-3.3H14Z"/></svg></a>{%- endif -%}
      {%- if settings.social_you != blank -%}<a href="{{ settings.social_you }}" target="_blank" rel="noopener" aria-label="YouTube Louis Yoga"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="5" width="19" height="14" rx="3.5"/><path d="M10 9.2v5.6l4.8-2.8z"/></svg></a>{%- endif -%}
      {%- if settings.social_zl != blank -%}<a class="lyx-zalo" href="{{ settings.social_zl }}" target="_blank" rel="noopener" aria-label="Chat Zalo với Louis Yoga">Zalo</a>{%- endif -%}
    </div>
    <hr class="lyx-foot-rule" style="margin-top:0">
    <div class="lyx-foot-bot">
      <p>{{ 'now' | date: '%Y' }} Louisyoga. All rights reserved</p>
      <div class="lyx-pay" aria-label="Phương thức thanh toán">{% for i in (1..4) %}{% capture pimg %}payment-{{ i }}.png{% endcapture %}<img src="{{ pimg | asset_url }}" alt="" width="52" height="26" loading="lazy">{% endfor %}</div>
    </div>
  </div>
</footer>
