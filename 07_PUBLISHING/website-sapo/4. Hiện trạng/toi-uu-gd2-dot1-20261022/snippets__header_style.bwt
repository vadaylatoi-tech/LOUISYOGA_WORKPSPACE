{{ 'style_page.scss.css' | asset_url | stylesheet_tag }}
{%if template contains 'cart'%}{{ 'cartpage.scss.css' | asset_url | stylesheet_tag }}	{%endif%}
{%if template contains 'blog' or template contains 'article'%}{{ 'blog_article_style.scss.css' | asset_url | stylesheet_tag }}{%endif%}
{%if template contains 'collection' or template contains 'blog'  or template contains 'article'%}{{ 'sidebar_style.scss.css' | asset_url | stylesheet_tag }}{%endif%}
{%if template contains 'product'%}{{ 'product_style.scss.css' | asset_url | stylesheet_tag }}{%endif%}
{%if template contains 'contact'%}{{ 'contact_style.scss.css' | asset_url | stylesheet_tag }}{%endif%}
{%if template contains 'customers'%}{{ 'account_oder_style.scss.css' | asset_url | stylesheet_tag }}{%endif%}
{%if template contains 'collection' or template contains 'search' or template contains 'page.favorite'%}{{ 'collection_style.scss.css' | asset_url | stylesheet_tag }}{%endif%}
{%if template contains 'search' %}{{ 'search_style.scss.css' | asset_url | stylesheet_tag }}{%endif%}
{%if template contains 'product' or template contains 'index' or template contains 'search' or template contains 'collection'  or template contains 'page'%}{{ 'quickviews_popup_cart.scss.css' | asset_url | stylesheet_tag }}{%endif%}